[Unit]
Description=Disk Partition Symlink
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target

[Service]
User=root
Group=root
SupplementaryGroups=disk
Restart=no
RemainAfterExit=yes
Type=oneshot
ExecStart=/usr/sbin/disksymlink-service

[Install]
WantedBy=sysinit.target
