		${LOCAL_ECHO} -e "166666\n333333\n666666\n1000000\n5000000\n" > streaming/framebased/h/2160p/dwFrameInterval

		mkdir streaming/header/h
		mkdir streaming/header/h1
		ln -s streaming/uncompressed/u1 streaming/header/h1
		ln -s streaming/mjpeg/m1 streaming/header/h1/m1
		ln -s streaming/h264/h streaming/header/h1/h1
		ln -s streaming/framebased/h streaming/header/h1/h1

		ln -s streaming/uncompressed/u streaming/header/h
		ln -s streaming/mjpeg/m streaming/header/h
		ln -s streaming/h264/h streaming/header/h
		ln -s streaming/framebased/h streaming/header/h
		ln -s streaming/header/h1 streaming/class/fs/
		ln -s streaming/header/h1 streaming/class/hs/
		ln -s streaming/header/h streaming/class/ss/
		cd /
	fi

	#Initialize NCM configuration
	if [ -d /sys/kernel/config/usb_gadget/g1/functions/ncm.0 ]; then
		cd /sys/kernel/config/usb_gadget/g1/functions/ncm.0
		${LOCAL_ECHO} 8000 > max_segment_size
		${LOCAL_ECHO} WINNCM > os_desc/interface.ncm/compatible_id
	fi

	#Initialize RNDIS SW path configuration
	if [ -d /sys/kernel/config/usb_gadget/g1/functions/rndis.rndis ]; then
		cd /sys/kernel/config/usb_gadget/g1/functions/rndis.rndis
		echo ef > class
		echo 4 > subclass
		echo 1 > protocol
	fi

	# enable adaptive for capture path
	if [ -d /sys/kernel/config/usb_gadget/g1/functions/uvc.0 ]; then
		${LOCAL_ECHO} adaptive > /sys/kernel/config/usb_gadget/g1/functions/uac2.0/c_sync
	fi

	# enable debug message
	if [ -f /sbin/usb/debuger/default_debug ];
	then
		rm -rf /sbin/usb/debuger/statusFile
		usb_debug -f on n /sbin/usb/debuger/default_debug
	fi

	# boot hsic composition:
	if [ -d /sys/class/android_usb/android1 ]
	then
		pid=`cat /etc/usb/boot_hsic_comp`
		# make 901D as default composition
                if [ -z "$pid" ]
		then
                    pid="901D"
		fi

		/sbin/usb/compositions/$pid y
		# let hsic compostion script run before starting hsusb
		sleep 1
	fi

	# boot hsusb composition:
	if [ -d /sys/class/android_usb/android0 ]
	then
		pid=`cat /etc/usb/boot_hsusb_comp`
		# exit with success if device is in mhi mode
		if [ "$pid" == "none" ]; then
			exit 0
		fi
		# make 901D as default composition
                if [ -z "$pid" ]
		then
                    pid="901D"
		fi

		# check if more than 1 argument is passed
		if [ $# -gt 1 ]; then
			# if second argument is n, do nothing
			if [ $2 != 'n' ]; then
				/sbin/usb/compositions/$pid n $adbd_params
			fi
		else
			/sbin/usb/compositions/$pid n $adbd_params
		fi

		# targets with cable detection support on Modem might need
		# more time for UDC to come up. So schedule a bind operation
		# accordingly
		udcname=`ls -1 /sys/class/udc | head -n 1`
		if [ -z $udcname ] && [ "$USB_ROLE_SWITCH" == "Y" ]; then
			usb_bind &
		fi
	fi
	;;

  start)
	udcname=`ls -1 /sys/class/udc | head -n 1`
	if [ -d /sys/kernel/config/usb_gadget ]; then
		${LOCAL_ECHO} "Starting USB Android Gadget"
		rm -f /tmp/usb_bind_in_progress
		${LOCAL_ECHO} $udcname > /sys/kernel/config/usb_gadget/g1/UDC
	fi
	;;

  stop)
	if [ -d /sys/kernel/config/usb_gadget ]; then
		${LOCAL_ECHO} "Stopping USB Android Gadget"
		${LOCAL_ECHO} start > /tmp/usb_bind_in_progress
		${LOCAL_ECHO} none > /sys/kernel/config/usb_gadget/g1/UDC
	fi
        ;;

  restart)
	${LOCAL_ECHO} "Restarting USB Android Gadget"
	$0 stop
	$0 start
        ;;
  *)
        ${LOCAL_ECHO} "Usage usb { start | stop | restart}" >&2
        exit 1
        ;;
esac

