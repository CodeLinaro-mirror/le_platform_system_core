# Starts the USB Android Gadget.
export KERNEL=`uname -r`
export SOFTAP_W_DUN="N"
export ANDROID_LOG_TAGS="*:d"
export LS_COLORS="none"
export USB_ROLE_SWITCH="N"
LOCAL_ECHO=$(which echo)

usb_bind() {
	timeout=0
	while :
	do
		UDC=`ls -1 /sys/class/udc | head -n 1`
		if [ ! -z $UDC ]; then
			${LOCAL_ECHO} $UDC > /sys/kernel/config/usb_gadget/g1/UDC
			break
		fi
		if [ "$timeout" -ge 25 ]; then
			${LOCAL_ECHO} "No role switch notification. Enabling USB in debug mode" > /dev/kmsg
			udcname=`ls -1 /sys/bus/platform/devices/ | grep ssusb | head -n 1`
			${LOCAL_ECHO} peripheral > /sys/bus/platform/devices/${udcname}/mode
			sleep 2
			UDC=`ls -1 /sys/class/udc | head -n 1`
			${LOCAL_ECHO} $UDC > /sys/kernel/config/usb_gadget/g1/UDC
			break
		fi
		timeout=`expr $timeout + 1`
		sleep 1
	done
}

